// closeWindows v2 — schema. Ver docs/superpowers/specs/2026-10-21-closewindows-v2-design.md.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String
  /// Usuario em minusculas: a unicidade sem diferenciar caixa vive no banco, nao so no codigo.
  usernameKey  String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  attempts     Attempt[]
}

/// Uma tentativa de fechar uma fase. Inicio e fim sao do relogio do SERVIDOR.
/// `fails` = erros que a fase relatou; `score` so existe quando `closed`.
model Attempt {
  id        String    @id @default(cuid())
  userId    String
  levelId   String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  fails     Int       @default(0)
  closed    Boolean   @default(false)
  timeMs    Int?
  score     Int?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, levelId])
  @@index([levelId, endedAt])
}
